# vim: ft=yaml

version: "2"
services:
  anthias-server:
    image: ghcr.io/screenly/anthias-server:${GIT_SHORT_HASH}-${BOARD}
    command:
      - /bin/sh
      - -ec
      - |
        python - <<'PY'
        import errno
        import os
        import shutil
        import sqlite3
        import tempfile
        from contextlib import closing
        from pathlib import Path

        def preserve_media(source, target):
            try:
                os.link(source, target)
            except OSError as exc:
                if exc.errno not in (errno.EACCES, errno.EPERM, errno.ENOTSUP, errno.EXDEV):
                    raise
                shutil.copy2(source, target)

        data = Path('/data')
        snapshot = data / '.pre-upgrade-2026.10.0'
        if not snapshot.exists():
            with tempfile.TemporaryDirectory(dir=data) as temp:
                staging = Path(temp) / 'snapshot'
                staging.mkdir(mode=0o700)
                for name in ('.anthias', '.screenly'):
                    config = data / name
                    if not config.is_dir() or config.is_symlink():
                        continue
                    dest = staging / name
                    dest.mkdir()
                    for filename in ('anthias.conf', 'screenly.conf', 'default_assets.yml'):
                        if (config / filename).is_file():
                            shutil.copy2(config / filename, dest / filename)
                    for filename in ('anthias.db', 'screenly.db'):
                        db = config / filename
                        if not db.is_file() or db.is_symlink():
                            continue
                        with closing(sqlite3.connect(db.as_uri() + '?mode=ro', uri=True)) as src:
                            with closing(sqlite3.connect(dest / filename)) as copy:
                                src.backup(copy)
                                if copy.execute('PRAGMA quick_check').fetchall() != [('ok',)]:
                                    raise RuntimeError(f'Invalid playlist snapshot for {db}')
                                if copy.execute("SELECT 1 FROM sqlite_master WHERE name='assets'").fetchone():
                                    count = copy.execute('SELECT COUNT(*) FROM assets').fetchone()[0]
                                    print(f'Pre-upgrade snapshot: {count} asset rows in {db}', flush=True)
                for name in ('anthias_assets', 'screenly_assets'):
                    media = data / name
                    if media.is_dir() and not media.is_symlink():
                        shutil.copytree(media, staging / name, copy_function=preserve_media, symlinks=True)
                staging.rename(snapshot)
        PY
        : > /usr/src/app/src/anthias_server/app/templates/_power_warning.html
        exec bash bin/start_server.sh
    ports:
      - 80:8080
    environment:
      - HOME=/data
      - LISTEN=0.0.0.0
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
    depends_on:
      - redis
    # No `devices:` here, and none needed. HDMI-CEC is driven by the
    # anthias-viewer container, which is privileged and therefore
    # already sees every /dev/cec* node; this service asks it over the
    # Redis command bus (src/anthias_server/lib/cec_client.py).
    #
    # That indirection is what makes CEC work on balena at all. The
    # compose file here is baked into the release from a workstation,
    # nothing on-device can enumerate the host's adapters, and a
    # statically listed node that turns out to be absent would stop the
    # container from starting. /dev/vchiq used to be listed for libcec,
    # which is gone.
    restart: always
    volumes:
      - resin-data:/data
    labels:
      io.balena.features.supervisor-api: '1'

  anthias-viewer:
    image: ghcr.io/screenly/anthias-viewer:${GIT_SHORT_HASH}-${BOARD}
    depends_on:
      - anthias-server
    # Issue #480 — to localise URL-asset rendering, set LANG (and
    # optionally LANGUAGE) as a balena Device or Service Variable in the
    # dashboard, e.g. LANG=nl_NL.UTF-8. balena's supervisor injects
    # dashboard variables as env vars into the running container at
    # boot, so no entry is needed in this `environment:` block —
    # AnthiasWebview reads QLocale::system() and builds Accept-Language
    # from whatever LANG/LANGUAGE the supervisor passed in.
    environment:
      - HOME=/data
      - PORT=8080
      - NOREFRESH=1
      - LISTEN=anthias-server
      # Lets start_viewer.sh reach the host systemd over the host system
      # bus (mounted by io.balena.features.dbus below) to quit the
      # Plymouth boot splash before launching the display. balenaOS
      # leaves Plymouth running and on x86 it holds DRM master, which
      # blocks cage. See release_boot_splash() in bin/start_viewer.sh.
      - DBUS_SYSTEM_BUS_ADDRESS=unix:path=/host/run/dbus/system_bus_socket
    privileged: true
    restart: always
    shm_size: ${SHM_SIZE}
    volumes:
      - resin-data:/data
    labels:
      io.balena.features.supervisor-api: '1'
      io.balena.features.dbus: '1'

  anthias-celery:
    # Runs on the same image as anthias-server with a CMD override.
    # See docker-compose.yml.tmpl for context on the merge.
    image: ghcr.io/screenly/anthias-server:${GIT_SHORT_HASH}-${BOARD}
    command: >
      nice -n 19 ionice -c 3
      celery -A anthias_server.celery_tasks.celery worker -B -n worker@anthias
      --loglevel=info --schedule /tmp/celerybeat-schedule
    depends_on:
      - anthias-server
      - redis
    environment:
      - HOME=/data
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
    # No `devices:` here, and none needed. HDMI-CEC is driven by the
    # anthias-viewer container, which is privileged and therefore
    # already sees every /dev/cec* node; this service asks it over the
    # Redis command bus (src/anthias_server/lib/cec_client.py).
    #
    # That indirection is what makes CEC work on balena at all. The
    # compose file here is baked into the release from a workstation,
    # nothing on-device can enumerate the host's adapters, and a
    # statically listed node that turns out to be absent would stop the
    # container from starting. /dev/vchiq used to be listed for libcec,
    # which is gone.
    restart: always
    volumes:
      - resin-data:/data
    labels:
      io.balena.features.supervisor-api: '1'

  redis:
    image: ghcr.io/screenly/anthias-redis:${GIT_SHORT_HASH}-${BOARD}
    command: >
      sh -ec '
        if [ -f /var/lib/redis/appendonlydir/appendonly.aof.manifest ]; then
          echo "Checking Redis AOF manifest before startup";
          cp -a /var/lib/redis/appendonlydir "/var/lib/redis/appendonlydir.backup.$(date +%Y%m%d%H%M%S)" || true;
          yes | redis-check-aof --fix /var/lib/redis/appendonlydir/appendonly.aof.manifest;
        fi;
        exec redis-server --protected-mode no --dir /var/lib/redis --appendonly yes --save "3600 1" --save "300 100" --save "60 10000"
      '
    ports:
      - 127.0.0.1:6379:6379
    restart: always
    volumes:
      - redis-data:/var/lib/redis

volumes:
  resin-data:
  redis-data:
